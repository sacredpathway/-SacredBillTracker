<?xml version="1.0" encoding="UTF-8"?>
<!--
  Partial Info.plist for Sacred Bill Tracker (iOS), wired into the Xcode project.

  PURPOSE: add the two attribution keys that cannot be expressed as generated
  build settings: NSUserTrackingUsageDescription (ATT prompt copy) and
  SKAdNetworkItems (an array — build-setting INFOPLIST_KEY_* cannot hold arrays).

  HOW IT PRESERVES YOUR GENERATED KEYS:
  This is a PARTIAL plist used in MERGE mode. You keep
  GENERATE_INFOPLIST_FILE = YES and ALSO point INFOPLIST_FILE at this file.
  Since Xcode 13+, the build system MERGES all generated keys
  (CFBundleShortVersionString, CFBundleVersion, UIApplicationSceneManifest,
  orientations, MinimumOSVersion, ITSAppUsesNonExemptEncryption, icons, etc.)
  ON TOP OF this file. So you only list the EXTRA keys here; everything your
  app already generates stays intact. Do NOT set GENERATE_INFOPLIST_FILE = NO
  unless you intend to hand-maintain every key (see "Full switch" in the guide).

  For reference, the keys your build currently GENERATES (from the shipped
  v1.0.12 IPA) and that the merge preserves:
    CFBundleIdentifier        com.sacredbilltracker.app
    CFBundleShortVersionString $(MARKETING_VERSION)   (was 1.0.12)
    CFBundleVersion           $(CURRENT_PROJECT_VERSION) (was 27)
    MinimumOSVersion          17.0
    UIApplicationSceneManifest (generated, multi-scene)
    Supported orientations    iPhone + iPad
    ITSAppUsesNonExemptEncryption  false
    App icons / device family / launch screen
  You do NOT need to copy those here — the merge keeps them.
-->
<plist version="1.0">
<dict>
	<!-- AppsFlyer Dev Key injected from Secrets.xcconfig (build setting APPSFLYER_DEV_KEY),
	     substituted at build time and read at runtime via the bundle info dictionary.
	     Stays a placeholder until the real key is set in the git-ignored Secrets.xcconfig;
	     the app refuses to start AppsFlyer while it is a placeholder. -->
	<key>AppsFlyerDevKey</key>
	<string>$(APPSFLYER_DEV_KEY)</string>

	<!-- Send privacy-preserving SKAdNetwork and AdAttributionKit postback
	     copies to AppsFlyer. Apple reads these endpoints from the app bundle;
	     no runtime code or ATT authorization is required. -->
	<key>NSAdvertisingAttributionReportEndpoint</key>
	<string>https://appsflyer-skadnetwork.com/</string>
	<key>AttributionCopyEndpoint</key>
	<string>https://appsflyer-skadnetwork.com/</string>

	<!-- TikTok Business SDK credentials, injected from the git-ignored
	     Secrets.xcconfig (build settings TIKTOK_ACCESS_TOKEN / TIKTOK_APP_ID)
	     and read at runtime via the bundle info dictionary. When a build setting
	     is undefined, $(VAR) substitutes to an empty string and the app refuses
	     to initialize the TikTok SDK (safe dormant no-op).
	       • TikTokAccessToken — SECRET. Never commit a real value.
	       • TikTokAppID       — the TikTok App ID from Events Manager (iOS data
	                             source 6762890363). The Apple App Store ID is a
	                             public constant inside TikTokEventsManager. -->
	<key>TikTokAccessToken</key>
	<string>$(TIKTOK_ACCESS_TOKEN)</string>
	<key>TikTokAppID</key>
	<string>$(TIKTOK_APP_ID)</string>

	<!-- App Tracking Transparency prompt copy. REQUIRED now that the app
	     requests ATT (IDFA) for TikTok attribution.
	     ⚠️ CONSISTENCY RULE: this key, PrivacyInfo.xcprivacy (NSPrivacyTracking)
	     and the App Store Privacy Label must all agree at submission time.
	     Both SDKs remain dormant until real credentials are supplied, but the
	     declared posture is now "tracking". Do not ship a build that declares
	     tracking while the App Store label still says otherwise. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Sacred Bill Tracker uses your device identifier to measure how well our ads perform. Declining will not limit any feature of the app.</string>

	<!-- Xcode merges AppsFlyer's legitimate NSPrivacyTrackingDomains into the
	     generated application Info.plist. Apple requires this matching flag
	     whenever that generated domain array is non-empty. -->
	<key>NSPrivacyTracking</key>
	<true/>

