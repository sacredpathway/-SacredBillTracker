# Sacred Bill Tracker staging/sandbox integration template.
# Local example only. Do not put production credentials in this file.
# Do not commit real private keys, service-account JSON, webhook secrets, or
# App Store Connect API private keys.

# iOS staging acceptance route. The app rejects production hosts when compiled
# with SBT_STAGING_ACCEPTANCE.
SBT_STAGING_PROJECT=thwjnpofhrpxfuvwkfgd
SBT_STAGING_URL=https://thwjnpofhrpxfuvwkfgd.supabase.co
SBT_STAGING_PUBLIC_KEY=REPLACE_WITH_STAGING_ANON_OR_PUBLISHABLE_KEY

# Optional iOS sandbox account flow. These must point at the same isolated
# staging project, not the production/default Supabase project.
SBT_SANDBOX_ACCOUNT_URL=https://thwjnpofhrpxfuvwkfgd.supabase.co/functions/v1/sbt-sandbox-account
SBT_SANDBOX_ANON_KEY=REPLACE_WITH_STAGING_ANON_OR_PUBLISHABLE_KEY

# Android staging sync/account config. Values should be injected by a secure
# debug/staging build path, not hard-coded into release sources.
SACRED_SYNC_BASE_URL=https://thwjnpofhrpxfuvwkfgd.supabase.co
SACRED_SYNC_ANON_KEY=REPLACE_WITH_STAGING_ANON_OR_PUBLISHABLE_KEY
SACRED_ACCOUNT_ORIGIN=https://thwjnpofhrpxfuvwkfgd.supabase.co/functions/v1/sbt-sandbox-account

# Apple sandbox server verification. Private key material must be stored in a
# secret manager or protected local secret file, never pasted into source.
APPLE_BUNDLE_ID=com.sacredbilltracker.app
APPLE_ENVIRONMENT=sandbox
APPLE_APP_STORE_CONNECT_ISSUER_ID=REPLACE_WITH_ISSUER_ID
APPLE_APP_STORE_CONNECT_KEY_ID=REPLACE_WITH_KEY_ID
APPLE_APP_STORE_CONNECT_PRIVATE_KEY_REF=REPLACE_WITH_SECRET_REFERENCE
APPLE_APP_APPLE_ID=REPLACE_WITH_APPLE_APP_ID_IF_REQUIRED
APPLE_SERVER_NOTIFICATION_SHARED_SECRET_REF=REPLACE_WITH_SECRET_REFERENCE_IF_USED

# Google Play sandbox/server verification.
GOOGLE_PLAY_PACKAGE_NAME=com.sacredbilltracker.app
GOOGLE_PLAY_ENVIRONMENT=sandbox
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_REF=REPLACE_WITH_SECRET_REFERENCE
GOOGLE_PLAY_RTDN_TOPIC=projects/REPLACE_WITH_PROJECT/topics/REPLACE_WITH_TOPIC
GOOGLE_PLAY_RTDN_SUBSCRIPTION=projects/REPLACE_WITH_PROJECT/subscriptions/REPLACE_WITH_SUBSCRIPTION

# Product IDs expected by the current local contract.
IOS_RECEIPT_JAR_PRODUCT_ID=com.sacredbilltracker.app.receiptjar.lifetime
ANDROID_RECEIPT_JAR_PRODUCT_ID=REPLACE_WHEN_ANDROID_ONE_TIME_PRODUCT_EXISTS
