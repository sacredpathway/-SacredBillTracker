//
//  AppDelegate.swift
//  Sacred Pathway Driver Hub — P5 (Notifications)
//
//  Handles APNs registration + remote/silent push delivery.
//  Owns lifecycle hooks that the SwiftUI App layer wires in via @UIApplicationDelegateAdaptor.
//
//  This is intentionally thin — the heavy lifting lives in NotificationManager and
//  DeviceTokenSync. Keep this file boring.
//

import UIKit
import UserNotifications

final class SPHAppDelegate: NSObject, UIApplicationDelegate {

    func application(
        _ application: UIApplication,
        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]? = nil
    ) -> Bool {

        // Wire UNUserNotificationCenter delegate so foreground banners + tap routing work.
        UNUserNotificationCenter.current().delegate = NotificationManager.shared

        // If user has previously granted permission, re-register for APNs on every launch.
        // This refreshes the token if iOS rotated it.
        Task { @MainActor in
            await NotificationManager.shared.refreshAuthorization()
            if NotificationManager.shared.systemAuthorizationGranted {
                NotificationManager.shared.registerForRemotePush()
            }

            // If a notification launched the app (cold-start tap), surface the deep link.
            if let userInfo = launchOptions?[.remoteNotification] as? [AnyHashable: Any] {
                NotificationManager.shared.handleColdStartPayload(userInfo)
            }
        }

        return true
    }

    // MARK: - APNs token

    func application(_ application: UIApplication,
                     didRegisterForRemoteNotificationsWithDeviceToken deviceToken: Data) {
        let tokenHex = deviceToken.map { String(format: "%02x", $0) }.joined()
        Task { await DeviceTokenSync.shared.register(tokenHex: tokenHex) }
    }

    func application(_ application: UIApplication,
                     didFailToRegisterForRemoteNotificationsWithError error: Error) {
        // Non-fatal — local notifications continue to work.
        // Logged for diagnostics; no user-facing error.
        #if DEBUG
        print("[push] APNs registration failed: \(error.localizedDescription)")
        #endif
    }

    // MARK: - Silent + visible remote pushes

    /// Background / silent push (content-available: 1) — used by the cloud to nudge
    /// the app into pulling new settlements without showing a banner.
    func application(
        _ application: UIApplication,
        didReceiveRemoteNotification userInfo: [AnyHashable: Any],
        fetchCompletionHandler completionHandler: @escaping (UIBackgroundFetchResult) -> Void
    ) {
        Task {
            let result = await NotificationManager.shared.handleRemotePayload(userInfo)
            completionHandler(result)
        }
    }
}

