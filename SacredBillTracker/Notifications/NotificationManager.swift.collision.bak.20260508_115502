//
//  NotificationManager.swift
//  Sacred Pathway Driver Hub — P5
//
//  UNUserNotificationCenter wrapper.
//  Handles: authorization, posting (immediate + scheduled), cancelling, deep-link payloads,
//  preference gating, lock-screen privacy, quiet hours.
//

import Foundation
import UserNotifications
import UIKit
import Combine

@MainActor
final class NotificationManager: NSObject, ObservableObject {

    static let shared = NotificationManager()

    private let center = UNUserNotificationCenter.current()
    private let prefs = NotificationPreferences.shared

    /// Driven by the OS — true if the user has granted permission.
    @Published var systemAuthorizationGranted: Bool = false

    /// Last deep link triggered by a notification tap. Drives in-app navigation.
    @Published var pendingDeepLink: NotificationDeepLink?
    /// Optional payload from a notification tap (e.g. settlement reference id, share id)
    @Published var pendingDeepLinkPayload: [String: String] = [:]

    private override init() {
        super.init()
        center.delegate = self
        Task { await refreshAuthorization() }
    }

    // MARK: - Authorization

    func requestAuthorization() async {
        do {
            let granted = try await center.requestAuthorization(
                options: [.alert, .badge, .sound, .timeSensitive]
            )
            await MainActor.run { systemAuthorizationGranted = granted }
        } catch {
            await MainActor.run { systemAuthorizationGranted = false }
        }
    }

    func refreshAuthorization() async {
        let settings = await center.notificationSettings()
        let granted = (settings.authorizationStatus == .authorized
                    || settings.authorizationStatus == .provisional)
        await MainActor.run { systemAuthorizationGranted = granted }
    }

    /// Hook this from your AppDelegate / SceneDelegate to register for APNs push.
    /// Safe to call before the user has granted permission — UIApplication will no-op.
    func registerForRemotePush() {
        UIApplication.shared.registerForRemoteNotifications()
    }

    // MARK: - Posting

    /// Single entry point. Applies preferences (category gate, quiet hours, lock-screen privacy).
    /// Returns true if a notification was actually scheduled.
    @discardableResult
    func notify(
        category: NotificationCategory,
        title: String? = nil,
        body: String,
        privacyBody: String? = nil,        // shown when lockScreenPrivacy is on
        identifier: String? = nil,         // for dedup / cancellation
        deepLink: NotificationDeepLink? = nil,
        payload: [String: String] = [:],
        delay: TimeInterval? = nil,
        scheduledDate: Date? = nil,
        repeats: Bool = false
    ) async -> Bool {

        guard systemAuthorizationGranted else { return false }
        guard prefs.shouldPost(category) else { return false }

        let content = UNMutableNotificationContent()
        content.title = title ?? category.title
        content.body = effectiveBody(category: category, body: body, privacyBody: privacyBody)
        content.sound = .default
        content.categoryIdentifier = category.rawValue

        // Time sensitivity (iOS 15+)
        switch category.interruptionLevel {
        case .timeSensitive: content.interruptionLevel = .timeSensitive
        case .active:        content.interruptionLevel = .active
        case .passive:       content.interruptionLevel = .passive
        case .critical:      content.interruptionLevel = .critical
        }

        // Deep link in userInfo
        if let link = deepLink ?? Optional.some(category.deepLink) {
            content.userInfo["deepLink"] = link.rawValue
        }
        for (k, v) in payload { content.userInfo[k] = v }

        // Trigger
        let trigger: UNNotificationTrigger?
        if let date = scheduledDate {
            let comps = Calendar.current.dateComponents(
                [.year, .month, .day, .hour, .minute, .second],
                from: date
            )
            trigger = UNCalendarNotificationTrigger(dateMatching: comps, repeats: repeats)
        } else if let delay, delay > 0 {
            trigger = UNTimeIntervalNotificationTrigger(timeInterval: delay, repeats: repeats)
        } else {
            trigger = nil   // deliver immediately
        }

        let id = identifier ?? "\(category.rawValue).\(UUID().uuidString)"
        let request = UNNotificationRequest(identifier: id, content: content, trigger: trigger)

        do { try await center.add(request); return true }
        catch { return false }
    }

    private func effectiveBody(category: NotificationCategory, body: String, privacyBody: String?) -> String {
        if prefs.lockScreenPrivacy && category.canContainSensitiveData {
            return privacyBody ?? "Open Sacred Pathway Driver Hub for details."
        }
        return body
    }

    // MARK: - Cancellation

    /// Cancel all pending (scheduled) notifications with these identifiers.
    func cancel(identifiers: [String]) {
        center.removePendingNotificationRequests(withIdentifiers: identifiers)
        center.removeDeliveredNotifications(withIdentifiers: identifiers)
    }

    /// Cancel all notifications for a particular share link
    /// (uses the share id in the identifier — see ShareLinkManager wiring).
    func cancelForShare(_ shareId: UUID) {
        cancel(identifiers: [
            shareIdentifier(shareId, suffix: "expiring_soon"),
            shareIdentifier(shareId, suffix: "expired"),
        ])
    }

    func shareIdentifier(_ shareId: UUID, suffix: String) -> String {
        "share.\(shareId.uuidString).\(suffix)"
    }

    // MARK: - Convenience: schedule share-link expiry notifications

    /// Schedules "expiring soon" 24h before expiry (only if expiry > 24h from now)
    /// AND "expired" at the expiry instant.
    func scheduleShareLinkNotifications(
        shareId: UUID,
        documentLabel: String,
        recipient: String?,
        expiresAt: Date
    ) async {
        let now = Date()
        let warnAt = expiresAt.addingTimeInterval(-86_400)
        if warnAt > now {
            await notify(
                category: .shareLinkExpiringSoon,
                body: "\(documentLabel) shared with \(recipient ?? "lender") expires in 24 hours.",
                identifier: shareIdentifier(shareId, suffix: "expiring_soon"),
                deepLink: .shareLinks,
                payload: ["shareId": shareId.uuidString],
                scheduledDate: warnAt
            )
        }
        if expiresAt > now {
            await notify(
                category: .shareLinkExpired,
                body: "\(documentLabel) share link has expired.",
                identifier: shareIdentifier(shareId, suffix: "expired"),
                deepLink: .shareLinks,
                payload: ["shareId": shareId.uuidString],
                scheduledDate: expiresAt
            )
        }
    }

    // MARK: - Convenience: weekly / monthly summary reminders

    /// Friday at 5pm local — recurring.
    func enableWeeklySummaryReminder() async {
        var comps = DateComponents()
        comps.weekday = 6   // Friday (1 = Sunday in Calendar)
        comps.hour = 17
        comps.minute = 0
        let trigger = UNCalendarNotificationTrigger(dateMatching: comps, repeats: true)
        let content = UNMutableNotificationContent()
        content.title = NotificationCategory.earningsSummaryWeekly.title
        content.body = "Open Sacred Pathway Driver Hub to review this week's settlements and net pay."
        content.sound = .default
        content.userInfo["deepLink"] = NotificationDeepLink.earningsSummary.rawValue
        let req = UNNotificationRequest(identifier: "weekly.summary.repeat",
                                        content: content, trigger: trigger)
        try? await center.add(req)
    }

    func disableWeeklySummaryReminder() {
        cancel(identifiers: ["weekly.summary.repeat"])
    }

    /// 1st of every month at 9am local — recurring.
    func enableMonthlySummaryReminder() async {
        var comps = DateComponents()
        comps.day = 1
        comps.hour = 9
        comps.minute = 0
        let trigger = UNCalendarNotificationTrigger(dateMatching: comps, repeats: true)
        let content = UNMutableNotificationContent()
        content.title = NotificationCategory.earningsSummaryMonthly.title
        content.body = "Last month's earnings summary is ready. Open the dashboard to review."
        content.sound = .default
        content.userInfo["deepLink"] = NotificationDeepLink.earningsSummary.rawValue
        let req = UNNotificationRequest(identifier: "monthly.summary.repeat",
                                        content: content, trigger: trigger)
        try? await center.add(req)
    }

    func disableMonthlySummaryReminder() {
        cancel(identifiers: ["monthly.summary.repeat"])
    }
}

// MARK: - Foreground presentation + tap routing
extension NotificationManager: UNUserNotificationCenterDelegate {

    /// Show notifications even when the app is foregrounded (subject to category prefs already gating posts).
    nonisolated func userNotificationCenter(
        _ center: UNUserNotificationCenter,
        willPresent notification: UNNotification
    ) async -> UNNotificationPresentationOptions {
        return [.banner, .list, .sound, .badge]
    }

    /// User tapped a notification — extract deep link payload and publish for the app to route.
    nonisolated func userNotificationCenter(
        _ center: UNUserNotificationCenter,
        didReceive response: UNNotificationResponse
    ) async {
        let info = response.notification.request.content.userInfo
        guard let raw = info["deepLink"] as? String,
              let link = NotificationDeepLink(rawValue: raw)
        else { return }

        var payload: [String: String] = [:]
        for (k, v) in info {
            guard let key = k as? String, key != "deepLink" else { continue }
            if let s = v as? String { payload[key] = s }
        }

        await MainActor.run {
            self.pendingDeepLink = link
            self.pendingDeepLinkPayload = payload
        }
    }
}
