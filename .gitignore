.swiftpm/

# Recovery backups & editor/script backup files (never commit)
_RECOVERY_BACKUP_*/
*.bak
*.bak.*
*.collision.bak.*
*.compfix.bak.*
*.final.bak.*
*.uiapp.bak

# Secrets — never commit real keys (example file stays tracked)
**/Secrets.xcconfig
